SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
COMPUTE_SECRET=
EMBED_MODEL=intfloat/multilingual-e5-small
CODEBOOK_K=8
CODEBOOK_LEVELS=3
# 개인 추천 점수: rule(기본, 10/18 찾는 사람 · 분야 · 줄 수 있는 것 규칙을 섞은 한 방향) | min | avg | harmonic | one_way(예전 방식)
REC_SCORE=rule
# 테이블토크 · 커피챗 배정 점수 보정(10/17 좌석 비교 평가). 예전 방식은 둘 다 0
SEAT_CENTER=1
SEAT_TOPIC_WEIGHT=0.5
# 테이블토크 만족도 답별 만남 반영 세기. 빠진 답은 기본값
SAT_WEIGHTS=gained=1,different=0.33,unsure=0,mismatch=-0.2
# 포스터 관심도 답별 추천 방향 세기(9/29 C안과 같은 규칙, 리허설 뒤 다시 봄)
POSTER_WEIGHTS=learn_more=1,interesting=0.33,not_mine=-0.2
# 모델 입력 접두사. passage: 가 나은지는 아직 비교하지 않음
EMBED_PREFIX=query: 
# 1 이면 켜자마자 모델을 뒤에서 미리 올림(약 10초). 첫 계산이 늦지 않게
WARM_MODEL=1
# 커피챗 주도 선배 두 명의 좌석: facing(기본, 마주 보게 = 8명이면 좌석 1 · 5번, 10/23 운영진 확정) | adjacent(옆자리) | free(따로 정하지 않음)
COFFEE_LEAD_SEATING=facing
