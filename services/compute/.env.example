SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
COMPUTE_SECRET=
EMBED_MODEL=intfloat/multilingual-e5-small
CODEBOOK_K=8
CODEBOOK_LEVELS=3
TABLE_SIZE_MIN=5
TABLE_SIZE_MAX=6
# 커피챗 개인 추천 점수: min(기본) | avg | harmonic | one_way. 리허설 뒤 결정
REC_SCORE=min
# 모델 입력 접두사. passage: 가 나은지는 아직 비교하지 않음
EMBED_PREFIX=query: 
