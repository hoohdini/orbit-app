# 값은 팀 채널에서 받는다. 이 파일은 이름만 적고, 실제 값은 .env.local 에 둔다.

# Supabase 프로젝트 (개발용 orbit-dev). 대시보드 Project Settings > API
SUPABASE_URL=https://xxxx.supabase.co   # /rest/v1/ 가 붙어 있어도 된다
# 서버 전용. 브라우저 코드에서 절대 참조하지 않는다 (NEXT_PUBLIC_ 접두사 금지)
SUPABASE_SERVICE_ROLE_KEY=

# 로그인 세션 쿠키 서명 키. 32자 이상 임의 문자열
SESSION_SECRET=

# 계산 서비스 주소와 공유 비밀키 (M2 이후)
COMPUTE_URL=http://localhost:8000
COMPUTE_SECRET=

# 행사 식별자. 개발은 dev, 행사 당일은 orbit-2026
EVENT_ID=dev

# 포스터 퀴즈 시도 상한(같은 포스터). 넘으면 429 TOO_MANY_ATTEMPTS
POSTER_MAX_ATTEMPTS=3

# 응모권 지급 스탬프 임계값. 쉼표로 여러 개 지정 가능(예: 5,10). 운영진 미정이라 값은 여기서만 바꾼다
POSTER_RAFFLE_THRESHOLDS=5
