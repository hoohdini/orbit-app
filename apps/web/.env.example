# 값은 팀 채널에서 받는다. 이 파일은 이름만 적고, 실제 값은 .env.local 에 둔다.

# Supabase 프로젝트 (개발용 orbit-dev). 대시보드 Project Settings > API
SUPABASE_URL=https://xxxx.supabase.co
# 서버 전용. 브라우저 코드에서 절대 참조하지 않는다 (NEXT_PUBLIC_ 접두사 금지)
SUPABASE_SERVICE_ROLE_KEY=

# 로그인 세션 쿠키 서명 키. 32자 이상 임의 문자열
SESSION_SECRET=

# 계산 서비스 주소와 공유 비밀키 (M2 이후)
COMPUTE_URL=http://localhost:8000
COMPUTE_SECRET=

# 행사 식별자. 개발은 dev, 행사 당일은 orbit-2026
EVENT_ID=dev
